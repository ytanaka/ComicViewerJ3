{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-set-cursor-visible",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "log:default"
  ]
}
